{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.deps/vcpkg",
        "VCPKG_DOWNLOADS": "${sourceDir}/.deps/downloads",
        "VCPKG_DEFAULT_BINARY_CACHE": "${sourceDir}/.deps/binary-cache",
        "VCPKG_DISABLE_METRICS": "1"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.deps/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "unix-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ASTRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "unix-base",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "default",
      "displayName": "Default (GCC Debug)",
      "inherits": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "unix-base",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": "unix-base",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": "unix-base",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang Debug with clang-tidy",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-tidy",
      "cacheVariables": {
        "ASTRA_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "gcc-asan-ubsan",
      "displayName": "GCC Debug with ASan and UBSan",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-asan-ubsan",
      "cacheVariables": {
        "ASTRA_ENABLE_ADDRESS_SANITIZER": "ON",
        "ASTRA_ENABLE_UNDEFINED_BEHAVIOR_SANITIZER": "ON"
      }
    },
    {
      "name": "gcc-tsan",
      "displayName": "GCC Debug with TSan",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-tsan",
      "cacheVariables": {
        "ASTRA_ENABLE_THREAD_SANITIZER": "ON"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "displayName": "Clang Debug with ASan and UBSan",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-asan-ubsan",
      "cacheVariables": {
        "ASTRA_ENABLE_ADDRESS_SANITIZER": "ON",
        "ASTRA_ENABLE_UNDEFINED_BEHAVIOR_SANITIZER": "ON"
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Clang Debug with TSan",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-tsan",
      "cacheVariables": {
        "ASTRA_ENABLE_THREAD_SANITIZER": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "ASTRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "ASTRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC Debug with ASan",
      "inherits": "msvc-debug",
      "binaryDir": "${sourceDir}/build/msvc-asan",
      "cacheVariables": {
        "ASTRA_ENABLE_ADDRESS_SANITIZER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "build-default",
      "configurePreset": "default"
    },
    {
      "name": "build-gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "build-clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "build-clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "build-clang-tidy",
      "configurePreset": "clang-tidy"
    },
    {
      "name": "build-gcc-asan-ubsan",
      "configurePreset": "gcc-asan-ubsan"
    },
    {
      "name": "build-gcc-tsan",
      "configurePreset": "gcc-tsan"
    },
    {
      "name": "build-clang-asan-ubsan",
      "configurePreset": "clang-asan-ubsan"
    },
    {
      "name": "build-clang-tsan",
      "configurePreset": "clang-tsan"
    },
    {
      "name": "build-msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    },
    {
      "name": "build-msvc-asan",
      "configurePreset": "msvc-asan",
      "configuration": "Debug"
    },
    {
      "name": "format-check",
      "configurePreset": "gcc-debug",
      "targets": [
        "format-check"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clang-tidy",
      "configurePreset": "clang-tidy",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-gcc-asan-ubsan",
      "configurePreset": "gcc-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-gcc-tsan",
      "configurePreset": "gcc-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clang-asan-ubsan",
      "configurePreset": "clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clang-tsan",
      "configurePreset": "clang-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc-asan",
      "configurePreset": "msvc-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
